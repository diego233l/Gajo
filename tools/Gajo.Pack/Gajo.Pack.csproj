<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build step: appends the compressed conversion engine to the published Gajo.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Gajo.Core/Gajo.Core.csproj" />
  </ItemGroup>
</Project>
